NODE_ENV=production
# Development/test only. Production startup rejects non-empty values.
TEST_FIXED_OTP_EMAIL=
# Exactly five digits when configured.
TEST_FIXED_OTP_CODE=
DATABASE_URL=mongodb://user:password@mongo:27017/smart-shopping-mall
DNS_SERVERS=1.1.1.1,8.8.8.8
IP_ADDRESS=0.0.0.0
PORT=5000
CORS_ORIGIN=https://shop.example.com,https://admin.example.com
BCRYPT_SALT_ROUNDS=12
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRE_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_REFRESH_EXPIRE_IN=30d
EMAIL_FROM=no-reply@example.com
EMAIL_USER=replace-me
EMAIL_PASS=replace-me
EMAIL_PORT=587
EMAIL_HOST=smtp.example.com
PROJECT_NAME=Smart Shopping Mall
BRAND_LOGO=https://cdn.example.com/logo.png
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=https://api.example.com/api/v1/oauth/google/callback
FRONTEND_OAUTH_CALLBACK_URL=https://shop.example.com/auth/callback
SESSION_SECRET=replace-with-a-different-32-character-secret
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_REGION=us-east-1
AWS_BUCKET_NAME=replace-me
AWS_CLOUDFRONT_DOMAIN=https://cdn.example.com
STRIPE_SECRET_KEY=replace-me
WEBHOOK_SECRET=replace-me
STRIPE_CURRENCY=aed
API_PUBLIC_URL=https://api.example.com
# Base64 of the complete Firebase service-account JSON file. Server-side secret.
FIREBASE_SERVICE_ACCOUNT_KEY_BASE64=
# Public VAPID key used only by Flutter Web/browser push clients.
FIREBASE_WEB_PUSH_CREDENTIALS=
OPENAI_API_KEY=replace-me
PLATFORM_FEE_PERCENTAGE=12
# Policy defaults can be adjusted without a deployment/code change.
SELLER_STRIKE_SUSPENSION_THRESHOLD=3
MISSED_COLLECTION_CANCELLATION_THRESHOLD=3
BUYER_REJECTION_RESTRICTION_THRESHOLD=3
MAX_UPLOAD_BYTES=10485760
